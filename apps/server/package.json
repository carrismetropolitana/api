{
	"name": "@carrismetropolitana/api-server",
	"version": "1.0.0",
	"type": "module",
	"files": [
		"dist"
	],
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"scripts": {
		"build": "npm run clean && tsc && resolve-tspaths && npm run copy",
		"clean": "rm -rf dist",
		"copy": "cp -r ./src/assets ./dist/assets",
		"dev": "dotenv-run -f ./secrets/development/.env.development -- tsx watch ./src/index.ts",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"start": "node dist/index.js"
	},
	"dependencies": {
		"@carrismetropolitana/api-services": "*",
		"@carrismetropolitana/api-settings": "*",
		"@carrismetropolitana/api-utils": "*",
		"@fastify/swagger": "9.4.2",
		"@helperkits/logger": "20240703.1726.24",
		"@helperkits/timer": "20240627.34.23",
		"fastify": "5.2.1",
		"jwt-decode": "4.0.0",
		"luxon": "3.5.0",
		"pino-pretty": "13.0.0",
		"protobufjs": "7.4.0",
		"zod-openapi": "4.2.3"
	},
	"devDependencies": {
		"@carrismetropolitana/api-tsconfig": "*",
		"@carrismetropolitana/api-types": "*",
		"@carrismetropolitana/eslint": "20250303.2009.45",
		"@dotenv-run/cli": "1.3.6",
		"@types/luxon": "3.4.2",
		"@types/node": "22.13.9",
		"resolve-tspaths": "0.8.23",
		"tsx": "4.19.3",
		"typescript": "5.8.2"
	}
}
